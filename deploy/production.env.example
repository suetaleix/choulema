LOTTERY_ENV=production
LOTTERY_DB=/var/lib/choulema/lottery.sqlite
LOTTERY_BACKUP_DIR=/var/backups/choulema
LOTTERY_PUBLIC_URL=https://replace-with-your-domain.example
# Generate ONCE using: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this value across upgrades, otherwise existing activation cards cannot be redeemed.
LOTTERY_CARD_SECRET=
LOTTERY_ADMIN_PHONE=
LOTTERY_ADMIN_ID=admin
LOTTERY_ADMIN_PASSWORD=
# Private SMTP JSON, outside the release/static directory. See mail.example.json.
LOTTERY_MAIL_CONFIG_FILE=
V6_SALES_ENABLED=0
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
