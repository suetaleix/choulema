# Set these in the process environment; this file is an example, not auto-loaded.
LOTTERY_ENV=development
LOTTERY_DB=data/dev.sqlite
LOTTERY_MAX_USERS=0
# Optional initial administrator. Never reuse the v4 bundled credentials.
LOTTERY_ADMIN_PHONE=
LOTTERY_ADMIN_PASSWORD=
LOTTERY_ADMIN_ID=admin
# Direct Alipay RSA2 website payment. Never commit the key files.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
# Optional sandbox gateway for testing; production uses https://openapi.alipay.com/gateway.do.
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
LOTTERY_PUBLIC_URL=http://127.0.0.1:8908
V6_SALES_ENABLED=0
# Card HMAC secret: set a random 32+ character value before production card issuance.
LOTTERY_CARD_SECRET=
# Optional private directory for administrator-triggered SQLite backups.
# Defaults to backups/ beside LOTTERY_DB; never place inside static/.
LOTTERY_BACKUP_DIR=
# Registration requires email verification. Keep this private JSON file outside source/static.
# Keys: host, port, security (ssl/starttls), username, sender, password_file (or password).
LOTTERY_MAIL_CONFIG_FILE=
# Alternative: environment settings plus a private SMTP authorization-code file.
LOTTERY_SMTP_HOST=
LOTTERY_SMTP_PORT=465
LOTTERY_SMTP_SECURITY=ssl
LOTTERY_SMTP_USERNAME=
LOTTERY_SMTP_SENDER=
LOTTERY_SMTP_PASSWORD_FILE=
# Approved annual defaults: cosmic=990 cents, pro=9900 cents, 365 days.
# Optional database overrides: v6_price_cosmic, v6_price_pro. Sales remain disabled.
